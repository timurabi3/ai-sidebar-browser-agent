{
  "name": "ai-sidebar-browser-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "High-End AI Sidebar & Browser Agent — Manifest V3 Chrome extension (Vite + React + TS + Tailwind).",
  "scripts": {
    "dev": "vite",
    "preview:ui": "vite --config vite.preview.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:nocheck": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0",
    "@types/chrome": "0.0.287",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
